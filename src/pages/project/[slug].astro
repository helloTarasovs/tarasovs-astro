---
// Case studies: /project/<slug>/  (same URLs as WordPress ohio_portfolio)
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { articleSchema, breadcrumbSchema, withFallbackArticle } from '../../lib/schema';
import { categoryLabel } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const path = `/project/${d.slug}/`;
const title = d.seo?.title ?? `${d.title} - Tarasovs Digital Agency`;
const image = d.seo?.ogImage ?? d.cover?.src;
// Most project bodies are empty; the case study lives in summary / task / details / gallery.
const hasBody = !!project.body?.trim();
// Defaults guard against a stale content cache (e.g. a dev server started before the schema change)
const details = d.details ?? [];
const gallery = d.gallery ?? [];

const jsonld = [
  ...withFallbackArticle(d.jsonld, articleSchema({ path, title: d.title, description: d.seo?.description, image, published: d.pubDate, modified: d.updatedDate })),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Case Studies', path: '/case-studies/' },
    { name: d.title, path },
  ]),
];
---
<Base title={title} description={d.seo?.description} canonical={d.seo?.canonical ?? path} robots={d.seo?.robots} ogImage={image} ogType="article" jsonld={jsonld}>
  <article class="project">
    <header class="project-header container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol><li><a href="/">Home</a></li><li><a href="/case-studies/">Case Studies</a></li><li><span aria-current="page">{d.title}</span></li></ol>
      </nav>
      <h1 class="project-title">{d.title}</h1>
      {d.categories.length > 0 && (
        <ul class="project-tags" aria-label="Categories">
          {d.categories.map((c) => <li>{categoryLabel(c)}</li>)}
        </ul>
      )}
    </header>

    {d.cover && (
      <figure class="project-cover container">
        <img src={d.cover.src} alt={d.cover.alt || d.title} width={d.cover.width} height={d.cover.height} fetchpriority="high" decoding="async" />
      </figure>
    )}

    {(d.summary || hasBody || d.task || details.length > 0) && (
      <div class="project-info container">
        <div class="project-text">
          {d.summary && <div class="summary prose" set:html={d.summary} />}
          {hasBody && <div class="post-body prose"><Content /></div>}
        </div>
        {(d.task || details.length > 0) && (
          <aside class="project-facts" aria-label="Project details">
            {d.task && (
              <div class="task">
                <h2>Task</h2>
                <p set:html={d.task} />
              </div>
            )}
            {details.length > 0 && (
              <dl class="details">
                {details.map((x) => <div><dt>{x.label}</dt><dd set:html={x.value} /></div>)}
              </dl>
            )}
          </aside>
        )}
      </div>
    )}

    {gallery.length > 0 && (
      <section class="gallery container" aria-label="Project screenshots">
        {gallery.map((g) => (
          <figure class="reveal">
            <img src={g.src} alt={g.alt} width={g.width} height={g.height} loading="lazy" decoding="async" />
          </figure>
        ))}
      </section>
    )}

    <p class="back container"><a class="button button--ghost" href="/case-studies/">All case studies</a> <a class="button" href="/contact-us/#CForm">Start a project</a></p>
  </article>
</Base>

<style>
  .project { padding-block: var(--space-6) var(--space-8); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-2); padding: 0; list-style: none; font-size: var(--text-xs); color: var(--color-text-muted); }
  .crumbs li + li::before { content: '/'; margin-right: var(--space-2); opacity: 0.6; }
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover { color: var(--color-link); text-decoration: underline; }
  .project-header { margin-bottom: var(--space-6); }
  .project-title { margin-top: var(--space-5); max-width: 24ch; }
  .project-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); padding: 0; list-style: none; }
  .project-tags li { padding: var(--space-1) var(--space-3); border: 1px solid var(--color-border); border-radius: var(--radius-pill); color: var(--color-text-muted); font-size: var(--text-xs); }
  .project-cover { margin-bottom: var(--space-7); }
  .project-cover img { display: block; width: auto; max-width: 100%; height: auto; max-height: 720px; margin-inline: auto; border-radius: var(--radius-lg); } /* whole image, never cropped */

  .project-info { display: grid; gap: var(--space-6); }
  .summary { font-size: var(--text-lg); }
  .summary :global(p + p) { margin-top: 0.8em; }
  .project-text .post-body { margin-top: var(--space-5); }
  .project-facts { display: grid; gap: var(--space-5); align-content: start; padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  .task h2 { font-size: var(--text-xs); font-family: var(--font-text); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted); }
  .task p { margin-top: var(--space-2); font-size: var(--text-sm); }
  .details { display: grid; gap: var(--space-4); margin: 0; padding-top: var(--space-5); border-top: 1px solid var(--color-border); }
  .details dt { font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted); }
  .details dd { margin: var(--space-1) 0 0; font-size: var(--text-sm); overflow-wrap: anywhere; }

  .gallery { display: grid; gap: var(--space-5); margin-top: var(--space-8); }
  .gallery figure { margin: 0; }
  .gallery img { width: 100%; border-radius: var(--radius-md); border: 1px solid var(--color-border); background: var(--color-surface-2); }
  .back { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }
  .post-body:has(.ta-post) { max-width: 960px; }

  @media (min-width: 64em) {
    .project-info { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--space-8); }
    .project-facts { position: sticky; top: calc(var(--header-h) + var(--space-5)); }
  }
</style>
