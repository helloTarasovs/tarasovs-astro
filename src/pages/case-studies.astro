---
// /case-studies/  All projects, newest first, with the category filter. SEO from pages.json.
import CaseStudiesPage from '../components/CaseStudiesPage.astro';
import { wpPage } from '../lib/pages';
import { sortedProjects } from '../lib/projects';

const page = wpPage('/case-studies/');
const projects = await sortedProjects();
---
<CaseStudiesPage
  url="/case-studies/"
  projects={projects}
  seo={page.seo}
  jsonld={page.jsonld}
  home={{ name: 'Home', path: '/' }}
  crumbLabel="Breadcrumb"
  title="Case Studies"
  lead="Leave us a little info, and we’ll be in touch."
  cta={{ label: 'Get a Quote', href: '/contact-us/#CForm' }}
/>
