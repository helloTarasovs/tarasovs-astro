---
// /case-studies/  All projects, newest first, with the category filter. SEO from pages.json.
import Base from '../layouts/Base.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import { wpPage } from '../lib/pages';
import { breadcrumbSchema } from '../lib/schema';
import { sortedProjects, coverPreload } from '../lib/projects';

const page = wpPage('/case-studies/');
const projects = await sortedProjects();
const lcp = coverPreload(projects[0].data.cover);
const jsonld = [...page.jsonld, breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Case Studies', path: '/case-studies/' }])];
---
<Base title={page.seo.title} description={page.seo.description} canonical={page.seo.canonical} robots={page.seo.robots} ogImage={page.seo.ogImage} jsonld={jsonld}>
  {lcp && <link slot="head" rel="preload" as="image" fetchpriority="high" {...lcp} />}
  <div class="case-studies container">
    <header class="head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol><li><a href="/">Home</a></li><li><span aria-current="page">Case Studies</span></li></ol>
      </nav>
      <h1>Case Studies</h1>
      <p class="lead">Leave us a little info, and we’ll be in touch.</p>
      <a class="button" href="/contact-us/#CForm">Get a Quote</a>
    </header>
    <PortfolioGrid projects={projects} headingLevel="h2" priorityFirst revealFrom={6} />
  </div>
</Base>

<style>
  .case-studies { padding-block: var(--space-6) var(--space-9); }
  .head { margin-bottom: var(--space-8); }
  .crumbs ol { display: flex; gap: var(--space-2); padding: 0; list-style: none; font-size: var(--text-xs); color: var(--color-text-muted); }
  .crumbs li + li::before { content: '/'; margin-right: var(--space-2); opacity: 0.6; }
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover { color: var(--color-link); text-decoration: underline; }
  h1 { margin-top: var(--space-5); }
  .lead { margin-block: var(--space-4) var(--space-5); color: var(--color-text-muted); font-size: var(--text-lg); }
</style>
