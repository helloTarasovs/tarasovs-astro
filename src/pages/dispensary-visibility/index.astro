<script>
  const root = document.querySelector<HTMLElement>('[data-dir]');
  if (root) {
    const list = root.querySelector<HTMLOListElement>('[data-list]')!;
    const items = [...list.children] as HTMLLIElement[];
    const q = root.querySelector<HTMLInputElement>('[data-q]')!;
    const region = root.querySelector<HTMLSelectElement>('[data-region]')!;
    const band = root.querySelector<HTMLSelectElement>('[data-band]')!;
    const sort = root.querySelector<HTMLSelectElement>('[data-sort]')!;
    const areaBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-area]')].filter((b) => b.tagName === 'BUTTON');
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const more = root.querySelector<HTMLButtonElement>('[data-more]')!;
    let area = 'all';
    let expanded = false;

    const num = (li: HTMLElement, k: string) => Number(li.dataset[k]);
    const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      'score-desc': (a, b) => num(b, 'score') - num(a, 'score') || a.dataset.name!.localeCompare(b.dataset.name!),
      'score-asc': (a, b) => (num(a, 'score') < 0 ? 1 : num(b, 'score') < 0 ? -1 : num(a, 'score') - num(b, 'score')) || a.dataset.name!.localeCompare(b.dataset.name!),
      name: (a, b) => a.dataset.name!.localeCompare(b.dataset.name!),
      measured: (a, b) => num(b, 'measured') - num(a, 'measured'),
    };

    const apply = () => {
      const term = q.value.trim().toLowerCase();
      let shown = 0;
      for (const li of items) {
        const on =
          (!term || li.dataset.name!.includes(term) || li.dataset.city!.includes(term)) &&
          (area === 'all' || li.dataset.area === area) &&
          (!region.value || li.dataset.region === region.value) &&
          (!band.value || li.dataset.band === band.value);
        li.hidden = !on;
        if (on) shown++;
      }
      const sorted = [...items].sort(sorters[sort.value]);
      // Collapsed view = first 20 of the current order, only while nothing is filtered
      const filtering = !!term || area !== 'all' || !!region.value || !!band.value;
      sorted.forEach((li, i) => li.classList.toggle('is-extra', i >= 20));
      list.classList.toggle('is-collapsed', !expanded && !filtering);
      more.parentElement!.hidden = expanded || filtering;
      list.append(...sorted);
      count.textContent = shown === items.length ? `${items.length} profiles` : `${shown} of ${items.length} profiles`;
      empty.hidden = shown > 0;
    };

    more.addEventListener('click', () => {
      expanded = true;
      apply();
      (list.querySelectorAll('li')[20] as HTMLElement | undefined)?.querySelector('a')?.focus();
    });
    q.addEventListener('input', apply);
    [region, band, sort].forEach((s) => s.addEventListener('change', apply));
    areaBtns.forEach((b) =>
      b.addEventListener('click', () => {
        area = b.dataset.area!;
        areaBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        apply();
      }),
    );
  }

  // Citation access date = the reader's today (build date is only the no-JS fallback)
  document.querySelectorAll<HTMLElement>('[data-today]').forEach((el) => {
    el.textContent = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      const text = btn.parentElement!.querySelector('[data-citation]')!.textContent!;
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Select the text to copy';
      }
      setTimeout(() => (btn.textContent = 'Copy citation'), 2500);
    }),
  );
</script>
