---
// /dispensary-visibility/  New York Dispensary ChatGPT Visibility Index (hub).
// Rows, stats and the ItemList come from the profiles collection at build time; the directory
// is plain HTML (crawlable) and a small inline script only filters / sorts it.
// Layout and copy follow the live WordPress page (ta-index + tdv-live-profiles). SEO + JSON-LD from pages.json (the two FAQPage blocks are merged into one).
import Base from '../../layouts/Base.astro';
import { wpPage } from '../../lib/pages';
import { abs } from '../../lib/site';
import { dispensaryRows, indexStats, REGION_LABELS } from '../../lib/dispensaries';
import '../../styles/tdv-hub.css';

const page = wpPage('/dispensary-visibility/');
const rows = await dispensaryRows();
const stats = indexStats(rows);
const ranked = rows.filter((r) => r.rank != null);
const regionsPresent = Object.keys(REGION_LABELS).filter((id) => rows.some((r) => r.region === id));

const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const shortDate = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
const lastUpdated = stats.lastUpdated!;
const citationUrl = abs('/dispensary-visibility/');
const bandLabel = (id: string) => ({ strong: 'Strong', limited: 'Limited', low: 'Low', 'almost-invisible': 'Almost invisible' } as Record<string, string>)[id] ?? id;

// ---- JSON-LD: keep the WordPress graph, fill its empty ItemList, merge the two FAQPage blocks
const faqEntities: any[] = [];
const jsonld = page.jsonld
  .map((block: any) => {
    const graph = block['@graph'];
    if (graph) {
      block = {
        ...block,
        '@graph': graph.map((node: any) => {
          if (node['@type'] === 'FAQPage') {
            faqEntities.push(...node.mainEntity);
            return null;
          }
          if (node['@type'] === 'ItemList') {
            return {
              ...node,
              numberOfItems: ranked.length,
              itemListElement: ranked.map((r) => ({ '@type': 'ListItem', position: r.rank, name: r.name, url: abs(r.url) })),
            };
          }
          if (node['@type'] === 'WebPage') return { ...node, dateModified: lastUpdated.toISOString() };
          return node;
        }).filter(Boolean),
      };
      return block;
    }
    if (block['@type'] === 'FAQPage') {
      faqEntities.push(...block.mainEntity);
      return null;
    }
    if (block['@type'] === 'Dataset') return { ...block, dateModified: iso(lastUpdated) };
    return block;
  })
  .filter(Boolean);
const faqPage = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqEntities };
jsonld.push(faqPage);


const faq = [
  ['How is each dispensary measured?', 'Each published profile uses 10 standardized, non-branded recommendation prompts entered in 10 separate new ChatGPT Temporary Chats. The benchmark records the returned response, observed position, market and surfaced competitors.'],
  ['How is the ChatGPT Visibility score calculated?', 'Recorded results receive 100 points for #1, 85 for #2, 70 for #3, 55 for #4–5, 40 for an unranked mention and 0 for no mention. Market scores are combined using 70% Primary, 20% Secondary and 10% Regional weighting.'],
  ['What does “invisible” mean in this index?', 'A dispensary is classified as invisible when it receives no mentions across the complete standardized 10-prompt ChatGPT benchmark.'],
  ["Why can a dispensary's score change?", 'ChatGPT responses can vary by date, model, location, available sources and wording. A new benchmark snapshot may therefore produce a different set or order of recommendations.'],
  ['Why is a Pending profile excluded from the ranking?', 'A public score is published only after all 10 standardized checks have a documented result. A partial benchmark remains Pending and is excluded from the statistics and ranking.'],
  ['Which AI platforms does the index cover?', 'This edition measures ChatGPT only. Results from other AI platforms are not included in the published score.'],
  ['Does the index cover all licensed New York dispensaries?', 'No. The statistics describe the complete, published profiles in the measured sample shown on this page, not every licensed dispensary in New York State.'],
  ['Can I request that a dispensary be added?', 'Yes. Contact Tarasovs Digital Agency to request inclusion in a future measurement batch.'],
];
const points = [['#1 recommendation', '100'], ['#2 recommendation', '85'], ['#3 recommendation', '70'], ['#4–5 recommendation', '55'], ['Mentioned but unranked', '40'], ['Not mentioned', '0']];
---
<Base title={page.seo.title} description={page.seo.description} canonical={page.seo.canonical} robots={page.seo.robots} ogImage={page.seo.ogImage} jsonld={jsonld}>
  <div class="ta-index">
    <header class="ta-index-hero">
      <p class="ta-index-eyebrow">Live statewide research dataset</p>
      <h1>New York Dispensary ChatGPT Visibility Index</h1>
      <p class="ta-index-lede">A citation-ready ranking of New York cannabis dispensaries based on how often and how prominently they appeared in 10 recorded, non-branded ChatGPT recommendation prompts.</p>
      <ul class="ta-index-meta" aria-label="Study details">
        <li>Platform measured: ChatGPT</li>
        <li>Coverage: New York State</li>
        <li>Protocol: Separate Temporary Chats</li>
        <li>Publication threshold: 10/10 checks</li>
        <li>Publisher: Tarasovs Digital Agency</li>
      </ul>
    </header>

    <section class="ta-index-quick-answer" aria-labelledby="ta-quick-answer-title">
      <p class="ta-index-section-label" id="ta-quick-answer-title">Quick answer</p>
      <p><strong>The New York Dispensary ChatGPT Visibility Index measures whether a dispensary becomes part of ChatGPT’s answer when a user asks for a local cannabis recommendation.</strong> Every published score comes from 10 non-branded prompts entered in 10 separate Temporary Chats. A dispensary with zero mentions across all 10 recorded responses is classified as invisible.</p>
      <p>The live cards below report the current sample size, invisibility rate, average Share of Model score, highest score and every eligible published profile. Each profile links to its dated prompt-level evidence.</p>
    </section>

    <nav class="ta-index-toc" aria-label="On this page">
      <p class="ta-index-section-label">In this index</p>
      <ol>
        <li><a href="#live-rankings">Live statewide rankings</a></li>
        <li><a href="#definitions">Metric definitions</a></li>
        <li><a href="#statewide-coverage">Statewide coverage</a></li>
        <li><a href="#methodology">Methodology</a></li>
        <li><a href="#how-to-cite">How to cite</a></li>
        <li><a href="#faq">Frequently asked questions</a></li>
      </ol>
    </nav>

    <section class="ta-index-ranking" id="live-rankings" aria-label="Live New York dispensary ChatGPT visibility rankings">
      <section class="tdv-live-profiles tdv-live-profiles--ranking" data-tdv-live-profiles data-tdv-profile-limit="500">
        <div class="tdv-live-profiles__eyebrow">Statewide benchmark</div>
        <h2 class="tdv-live-profiles__title">New York dispensary ChatGPT visibility rankings</h2>
        <p class="tdv-live-profiles__intro">All published 10-prompt profiles, ranked from the strongest current Share of Model score to the weakest.</p>
        <div class="tdv-ranking-stats" aria-label="Current ChatGPT visibility benchmark statistics">
          <article class="tdv-ranking-stat"><p><strong>{stats.count}</strong> dispensaries are included in the current measured sample.</p></article>
          <article class="tdv-ranking-stat"><p><strong>{stats.invisiblePct}%</strong> of measured dispensaries received zero ChatGPT mentions across 10 prompts.</p></article>
          <article class="tdv-ranking-stat"><p>The average ChatGPT Share of Model score is <strong>{stats.average}/100</strong> across the measured sample.</p></article>
          <article class="tdv-ranking-stat"><p><strong>{stats.strongPct}%</strong> of measured dispensaries have strong visibility at 70/100 or higher.</p></article>
          <article class="tdv-ranking-stat"><p>The highest current ChatGPT Share of Model score is <strong>{stats.highest}/100</strong>.</p></article>
        </div>
        <div class="tdv-live-profiles__controls">
          <label class="tdv-live-profiles__search">
            <span class="visually-hidden">Search by dispensary name or city</span>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m21 21-4.35-4.35m2.35-5.15A7.5 7.5 0 1 1 4 11.5a7.5 7.5 0 0 1 15 0Z" /></svg>
            <input type="search" placeholder="Dispensary name or city…" autocomplete="off" data-tdv-profile-search />
          </label>
          <div class="tdv-live-profiles__scope" role="group" aria-label="Filter profiles by area">
            <button type="button" class="is-active" data-tdv-profile-scope="all" aria-pressed="true">All NY</button>
            <button type="button" data-tdv-profile-scope="nyc" aria-pressed="false">NYC</button>
            <button type="button" data-tdv-profile-scope="upstate" aria-pressed="false">Upstate</button>
          </div>
          <div class="tdv-live-profiles__selects">
            <label><span>Region</span>
              <select data-tdv-profile-region aria-label="Filter by region">
                <option value="all">All regions</option>
                {regionsPresent.map((id) => <option value={id}>{REGION_LABELS[id]}</option>)}
              </select>
            </label>
            <label><span>Visibility</span>
              <select data-tdv-profile-visibility aria-label="Filter by visibility">
                <option value="all">All visibility</option>
                <option value="strong">Strong</option>
                <option value="limited">Limited</option>
                <option value="low">Low</option>
                <option value="almost-invisible">Almost invisible</option>
              </select>
            </label>
            <label><span>Sort</span>
              <select data-tdv-profile-sort aria-label="Sort profiles">
                <option value="highest">Highest visibility</option>
                <option value="lowest">Lowest visibility</option>
                <option value="az">A–Z</option>
                <option value="recent">Recently measured</option>
              </select>
            </label>
          </div>
        </div>
        <p class="tdv-live-profiles__results" aria-live="polite" data-tdv-profile-results>Showing {ranked.length} of {ranked.length} profiles</p>
        <div class="tdv-live-profiles__grid" data-tdv-profile-grid>
          {ranked.map((r) => {
            const [place, region] = r.location.split(' · ');
            return (
              <article
                class="tdv-live-profile-card is-live"
                data-tdv-profile-card
                data-region={r.region}
                data-area={r.area}
                data-name={r.name.toLowerCase()}
                data-city={(r.city ?? '').toLowerCase()}
                data-score={r.score}
                data-visibility={r.band!.id}
                data-measured={r.measured ? Math.floor(r.measured.valueOf() / 1000) : 0}
              >
                <a class="tdv-live-profile-card__link" href={r.url} aria-label={`View ${r.name} visibility profile`}>
                  <div class="tdv-live-profile-card__rank" aria-label={`Rank ${r.rank}`}><span>Rank</span><strong>#{r.rank}</strong></div>
                  <div class="tdv-live-profile-card__top">
                    <div>
                      <h3>{r.name}</h3>
                      <p>{place}{region && <> <span aria-hidden="true">·</span> {region}</>}</p>
                      {r.measured && <time class="tdv-live-profile-card__measured" datetime={iso(r.measured)}>Measured {shortDate(r.measured)}</time>}
                    </div>
                    <div class="tdv-live-profile-card__score"><strong>{r.rounded}</strong><span>/100</span></div>
                  </div>
                  <div class="tdv-live-profile-card__visibility">
                    <span class="tdv-live-profile-card__label">{bandLabel(r.band!.id)}</span>
                    <span class="tdv-live-profile-card__meter" aria-label={`Visibility score ${r.rounded} out of 100`}><span style={`width:${r.rounded}%`}></span></span>
                  </div>
                  <div class="tdv-live-profile-card__footer"><span>View visibility profile →</span></div>
                </a>
              </article>
            );
          })}
        </div>
        <p class="tdv-live-profiles__filter-empty" data-tdv-profile-empty hidden>No profiles match these filters.</p>
        <p class="tdv-live-profiles__summary"><strong>{ranked.length}</strong> profiles published so far — new verified benchmarks are being added in controlled batches. New York has 705 licensed dispensaries open as of August 2026, and the Index is being built out across the state.</p>
        <a class="tdv-live-profiles__cta" href="/contact-us/">Add my dispensary</a>
      </section>
    </section>

    <section class="ta-index-section" id="definitions" aria-labelledby="ta-definitions-title">
      <p class="ta-index-section-label">Definitions</p>
      <h2 id="ta-definitions-title">How to interpret the ranking</h2>
      <div class="ta-index-definition-grid">
        <dl class="ta-index-definition-card"><dt>ChatGPT Visibility score</dt><dd>A 0–100 composite based on the observed prominence of a dispensary across three geographic market levels.</dd></dl>
        <dl class="ta-index-definition-card"><dt>Share of Model</dt><dd>The index’s comparable measure of how consistently and prominently a dispensary appeared in the recorded recommendation responses.</dd></dl>
        <dl class="ta-index-definition-card"><dt>Invisible in ChatGPT</dt><dd>A dispensary with zero recorded mentions across the complete standardized 10-prompt benchmark.</dd></dl>
        <dl class="ta-index-definition-card"><dt>READY profile</dt><dd>A public profile with a documented result for all 10 required checks. Partial benchmarks remain Pending and are excluded.</dd></dl>
      </div>
      <p><strong>This is a recommendation-discovery benchmark, not a traditional search-results ranking.</strong> A dispensary with no measured mentions is absent from the tested answers rather than merely appearing lower on a conventional results page.</p>
      <p>The statewide order uses the current composite score. Ties are ordered alphabetically. The measured date on each card identifies when that dispensary’s latest benchmark was recorded.</p>
    </section>

    <section class="ta-index-section" id="statewide-coverage" aria-labelledby="ta-coverage-title">
      <p class="ta-index-section-label">Geographic coverage</p>
      <h2 id="ta-coverage-title">A statewide view, not only New York City</h2>
      <p>The index includes eligible published profiles from New York City and from regions across the state. The geography controls are generated from the same live profile set as the ranking: NYC and Upstate appear only when those areas have matching profiles, and the Region menu lists only regions represented in the current published sample.</p>
      <p>Use the All NY, NYC, Upstate and Region controls to narrow the results without changing the underlying benchmark. Regional comparisons become more useful as coverage grows; a region with fewer published profiles should not be interpreted as stronger or weaker solely from its sample size.</p>
    </section>

    <section class="ta-index-section" id="methodology" aria-labelledby="ta-methodology-title">
      <p class="ta-index-section-label">Research design</p>
      <h2 id="ta-methodology-title">Complete methodology</h2>
      <p>ChatGPT Visibility measures how prominently each dispensary appeared in 10 recorded, non-branded ChatGPT recommendation checks across three geographic market levels.</p>
      <h3>Independent Temporary Chat protocol</h3>
      <ol class="ta-index-method-steps">
        <li>Each standardized prompt is entered in a separate new ChatGPT Temporary Chat with no previous benchmark conversation history.</li>
        <li>The returned response, observed recommendation position, market being tested and competing dispensaries surfaced in that response are recorded.</li>
        <li>Six prompts test the primary market, two prompts test the secondary market and two prompts test the regional or wider market.</li>
        <li>A public score is calculated only after all 10 standardized checks have a documented result.</li>
      </ol>
      <h3>Recommendation-position scoring</h3>
      <div class="ta-index-table-wrap" role="region" aria-label="Recommendation-position scoring" tabindex="0">
        <table class="ta-index-table">
          <thead><tr><th scope="col">Recorded result</th><th scope="col">Points</th></tr></thead>
          <tbody>{points.map(([r, pts]) => <tr><td>{r}</td><td>{pts}</td></tr>)}</tbody>
        </table>
      </div>
      <h3>Geographic weighting</h3>
      <p>The benchmark first calculates a score for each market level. The composite score then combines those three results using a fixed geographic weighting.</p>
      <div class="ta-index-formula"><strong>Composite score = Primary market 70% + Secondary market 20% + Regional/wider market 10%</strong></div>
      <h3>Validation and inclusion</h3>
      <p>A public score is not calculated from a partial benchmark. The benchmark is READY only when all 10 standardized checks have a documented result. If any recorded response is missing or cannot be classified, the profile remains Pending until the full 10-check benchmark is complete.</p>
      <p>The statistics and ranking include only published READY profiles. Drafts, incomplete benchmarks and profiles without a qualifying public result are excluded.</p>
      <h3>Benchmark source and limitations</h3>
      <p>This index uses directly observed Temporary Chat results: 10 separately recorded responses per published profile and the fixed 70% / 20% / 10% geographic weighting. Web results and directories are not used to reconstruct or estimate the recorded ChatGPT positions.</p>
      <div class="ta-index-note"><strong>Benchmark note:</strong> The index records standardized Temporary Chat checks rather than predicting what every user will see. ChatGPT responses can vary by date, model, location, available sources and wording. The score does not represent overall business quality, product quality, customer satisfaction or revenue performance.</div>
      <div class="ta-index-note"><strong>Scope:</strong> This edition measures ChatGPT only. It does not combine ChatGPT results with Google Maps, Google organic search, Perplexity, Gemini or Google AI Overviews.</div>
    </section>

    <section class="ta-index-section" id="how-to-cite" aria-labelledby="ta-citation-title">
      <p class="ta-index-section-label">For journalists and researchers</p>
      <h2 id="ta-citation-title">How to cite this data</h2>
      <p>When quoting a statewide statistic, include the dataset name, publisher, canonical URL and access date. The statistics update as eligible profiles are added or remeasured.</p>
      <div class="ta-index-citation"><strong>Suggested dataset citation:</strong> Tarasovs Digital Agency. “New York Dispensary ChatGPT Visibility Index.” <a href={citationUrl}>{citationUrl}</a>. Accessed [Month Day, Year].</div>
      <p>When citing a dispensary score, link to the individual profile and include the “Measured” date displayed on that profile. Do not describe the measured sample as every licensed dispensary in New York State.</p>
      <h3>Publisher and commercial disclosure</h3>
      <p>The index is published and maintained by <a href="/about/">Tarasovs Digital Agency</a>. Tarasovs also provides dispensary SEO and visibility services. Every included dispensary is evaluated with the same benchmark structure, profiles are published whether scores are high or low, and commercial relationships do not change the scoring rules.</p>
    </section>

    <section class="ta-index-faq" id="faq" aria-labelledby="ta-faq-title">
      <p class="ta-index-section-label">Questions</p>
      <h2 id="ta-faq-title">Frequently asked questions</h2>
      <div class="ta-index-faq-list">
        {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </section>

    <section class="ta-index-cta" aria-labelledby="ta-cta-title">
      <p class="ta-index-section-label">Tarasovs Digital Agency</p>
      <h2 id="ta-cta-title">Is your dispensary visible in ChatGPT?</h2>
      <p>Request a visibility check to see whether your dispensary appears across the same standardized local-intent benchmark.</p>
      <a class="ta-index-cta-button" href="/contact-us/">Request a visibility check →</a>
    </section>
  </div>
</Base>

<script>
  // Search / area / region / visibility / sort for the ranking cards (same behaviour as the plugin's tdv-live-profiles.js).
  document.querySelectorAll<HTMLElement>('[data-tdv-live-profiles]').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-tdv-profile-card]')];
    const grid = root.querySelector<HTMLElement>('[data-tdv-profile-grid]');
    const search = root.querySelector<HTMLInputElement>('[data-tdv-profile-search]');
    const scopeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-tdv-profile-scope]')];
    const region = root.querySelector<HTMLSelectElement>('[data-tdv-profile-region]');
    const visibility = root.querySelector<HTMLSelectElement>('[data-tdv-profile-visibility]');
    const sort = root.querySelector<HTMLSelectElement>('[data-tdv-profile-sort]');
    const empty = root.querySelector<HTMLElement>('[data-tdv-profile-empty]');
    const results = root.querySelector<HTMLElement>('[data-tdv-profile-results]');
    let limit = parseInt(root.dataset.tdvProfileLimit || '', 10);
    if (!Number.isFinite(limit) || limit < 1) limit = cards.length || 1;
    let scope = 'all';

    const norm = (v: unknown) => String(v ?? '').toLocaleLowerCase().trim();
    const compare = (a: HTMLElement, b: HTMLElement) => {
      const mode = sort ? sort.value : 'highest';
      const byName = norm(a.dataset.name).localeCompare(norm(b.dataset.name));
      const aScore = Number(a.dataset.score);
      const bScore = Number(b.dataset.score);
      if (mode === 'lowest') return aScore - bScore || byName;
      if (mode === 'az') return byName;
      if (mode === 'recent') return Number(b.dataset.measured) - Number(a.dataset.measured) || bScore - aScore;
      return bScore - aScore || byName;
    };
    const apply = () => {
      const query = norm(search?.value);
      const selectedRegion = region?.value ?? 'all';
      const selectedVisibility = visibility?.value ?? 'all';
      const matched: HTMLElement[] = [];
      cards.slice().sort(compare).forEach((card) => {
        grid?.appendChild(card);
        const ok =
          (!query || norm(`${card.dataset.name} ${card.dataset.city}`).includes(query)) &&
          (scope === 'all' || card.dataset.area === scope) &&
          (selectedRegion === 'all' || card.dataset.region === selectedRegion) &&
          (selectedVisibility === 'all' || card.dataset.visibility === selectedVisibility);
        if (ok) matched.push(card);
      });
      cards.forEach((card) => (card.hidden = true));
      matched.slice(0, limit).forEach((card) => (card.hidden = false));
      if (empty) empty.hidden = matched.length !== 0;
      if (results) results.textContent = matched.length ? `Showing ${Math.min(matched.length, limit)} of ${matched.length} profiles` : 'No matching profiles';
    };
    scopeButtons.forEach((button) =>
      button.addEventListener('click', () => {
        scope = button.dataset.tdvProfileScope || 'all';
        scopeButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        if (region) region.value = 'all';
        apply();
      }),
    );
    search?.addEventListener('input', apply);
    [region, visibility, sort].forEach((c) => c?.addEventListener('change', apply));
    apply();
  });
</script>
