---
// Canonical blog index (WordPress already 301s /insights/ here). Page 1.
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { sortedPosts, pageSlice } from '../../../lib/posts';
import { breadcrumbSchema } from '../../../lib/schema';

const { items, lastPage } = pageSlice(await sortedPosts(), 1);
---
<Base
  title="Insights Archives - Tarasovs Digital Agency"
  description="Explore expert insights on web design, development, SEO, GEO, AI search, Framer, Webflow, and digital growth from Tarasovs Digital Agency."
  canonical="/category/insights/"
  jsonld={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Insights', path: '/category/insights/' }])]}
>
  <div class="page container">
    <h1>Insights</h1>
    <PostList posts={items} currentPage={1} lastPage={lastPage} />
  </div>
</Base>
