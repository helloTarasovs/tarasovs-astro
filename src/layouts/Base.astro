---
// Every page goes through this layout. It owns <head>: title, description, canonical, robots, OG, Twitter, JSON-LD.
import { SITE, abs } from '../lib/site';
import { siteGraph } from '../lib/schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/dm-sans';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/motion.css';
// Same files the @font-face rules point to, so the preload is reused (latin subset only).
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import dmSansLatin from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  canonical?: string; // path like /about/ ; defaults to the current URL
  robots?: string; // e.g. "index, follow" or "noindex, follow"
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonld?: unknown[];
}

const {
  title,
  description,
  canonical,
  robots = 'index, follow',
  ogImage = SITE.defaultOgImage,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  jsonld = [],
} = Astro.props;

const canonicalUrl = abs(canonical ?? Astro.url.pathname);
// Drop byte-identical JSON-LD blocks (some WordPress entries carry the same block twice).
const jsonldBlocks = [...new Set(jsonld.map((block) => (typeof block === 'string' ? JSON.stringify(JSON.parse(block)) : JSON.stringify(block))))];
const ogImageUrl = abs(ogImage);
const robotsFull = robots.includes('index') && !robots.includes('noindex')
  ? `${robots}, max-image-preview:large, max-snippet:-1, max-video-preview:-1`
  : robots;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Runs before CSS paints: pick the saved theme, else the OS setting. No flash.
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSansLatin} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f9f9f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111013" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robotsFull} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageUrl} />
    {ogImage === SITE.defaultOgImage && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content={SITE.twitterCard} />

    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(siteGraph())} />
    {jsonldBlocks.map((block) => <script type="application/ld+json" set:html={block} />)}
    <slot name="head" />
  </head>
  <body>
    <script is:inline>
      // Post bodies (Ohio theme era) style dark mode against body.dark-scheme
      if (document.documentElement.dataset.theme === 'dark') document.body.classList.add('dark-scheme');
    </script>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header"><Header /></slot>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer"><Footer /></slot>
    <Analytics />
  </body>
</html>
