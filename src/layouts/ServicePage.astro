---
// One layout for every service page: hero, content sections, FAQ, CTA. Pages differ only in their JSON.
import Base from './Base.astro';
import Blocks from '../components/blocks/Blocks.astro';
import Faq from '../components/blocks/Faq.astro';
import Marquee from '../components/Marquee.astro';
import { wpPage } from '../lib/pages';
import { breadcrumbSchema } from '../lib/schema';
import { assertFaqMatchesSchema, dedupeJsonld, type ServicePageData } from '../lib/service-page';

interface Props { data: ServicePageData }
const { data } = Astro.props;
const center = data.variant === 'center';
const page = wpPage(data.url);
const pageJsonld = dedupeJsonld(page.jsonld);
assertFaqMatchesSchema(data, pageJsonld);

const crumbs = [...data.breadcrumb, { name: data.hero.crumb ?? data.hero.title.replace(/<[^>]+>/g, ''), path: data.url }];
const hasBreadcrumbLd = pageJsonld.some((b: any) => b?.['@type'] === 'BreadcrumbList');
const jsonld = hasBreadcrumbLd ? pageJsonld : [...pageJsonld, breadcrumbSchema(crumbs)];
const slugify = (s: string) => s.replace(/<[^>]+>/g, '').toLowerCase().replace(/&[a-z#0-9]+;/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60);
---
<Base title={page.seo.title} description={page.seo.description} canonical={page.seo.canonical} robots={page.seo.robots} ogImage={page.seo.ogImage} jsonld={jsonld}>
  <article class:list={['service', { 'service--center': center }]}>
    <header class:list={['hero', { 'hero--center': center }]}>
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            {crumbs.map((c, i) => (
              <li>{i < crumbs.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
            ))}
          </ol>
        </nav>
        <div class="hero-panel">
          {data.hero.eyebrow && (
            <p class="eyebrow">
              <span set:html={data.hero.eyebrow} />
              {center && <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6" /></svg>}
            </p>
          )}
          <h1 set:html={data.hero.title} />
          {data.hero.byline && <p class="hero-byline" set:html={data.hero.byline} />}
          {data.hero.lead && <div class="hero-lead" set:html={data.hero.lead} />}
          {!center && data.hero.chips && data.hero.chips.length > 0 && (
            <ul class="hero-chips">{data.hero.chips.map((c) => <li>{c}</li>)}</ul>
          )}
          {data.hero.actions && data.hero.actions.length > 0 && (
            <p class="hero-actions">
              {data.hero.actions.map((a, i) => <a class:list={['button', { 'button--ghost': i > 0 }]} href={a.href}>{a.label}</a>)}
            </p>
          )}
        </div>
        {center && data.hero.chips && data.hero.chips.length > 0 && (
          <div class="hero-marquee"><Marquee words={data.hero.chips} variant="plain" speed={40} /></div>
        )}
      </div>
    </header>

    {data.sections.map((s, i) => {
      // First section after the hero can sit on the first screen: never animated
      const reveal = i > 0;
      const id = s.id ?? (s.title ? slugify(s.title) : undefined);
      return (
        <section class:list={['section', s.tone && `tone-${s.tone}`]} id={id} aria-labelledby={s.title ? `${id}-title` : undefined}>
          <div class="container">
            {(s.eyebrow || s.title || s.intro) && (
              <div class:list={['section-head', { reveal }]}>
                {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
                {s.title && <h2 id={`${id}-title`} class:list={{ 'visually-hidden': s.titleHidden }} set:html={s.title} />}
                {s.intro && <div class="section-intro" set:html={s.intro} />}
              </div>
            )}
            <Blocks blocks={s.blocks} formSubject={data.formSubject} reveal={reveal} />
          </div>
        </section>
      );
    })}

    {data.faq && data.faq.items.length > 0 && (
      <section class="section" id="faq" aria-labelledby="faq-title">
        <div class="container"><div class="faq-wrap">
          <div class="section-head reveal">
            {data.faq.eyebrow && <p class="eyebrow">{data.faq.eyebrow}</p>}
            <h2 id="faq-title" set:html={data.faq.title} />
            {data.faq.intro && <p class="lead" set:html={data.faq.intro} />}
          </div>
          <Faq items={data.faq.items} reveal />
          {data.faq.note && <p class="faq-note" set:html={data.faq.note} />}
        </div></div>
      </section>
    )}

    {data.cta && (
      <section class="section" aria-labelledby="cta-title">
        <div class="container">
          <div class="cta reveal">
            {data.cta.eyebrow && <p class="eyebrow">{data.cta.eyebrow}</p>}
            <h2 id="cta-title" set:html={data.cta.title} />
            {data.cta.text && <p class="cta-text">{data.cta.text}</p>}
            {data.cta.action && (
              <a class="button button--highlight" href={data.cta.action.href}>
                {data.cta.action.label}
                <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5 11h11.6l-5.3-5.3L12.7 4.3 20.4 12l-7.7 7.7-1.4-1.4 5.3-5.3H5z" /></svg>
              </a>
            )}
          </div>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .service { padding-bottom: var(--space-6); }
  .hero { padding-block: var(--space-6) var(--space-7); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-2); padding: 0; list-style: none; font-size: var(--text-xs); color: var(--color-text-muted); }
  .crumbs li + li::before { content: '/'; margin-right: var(--space-2); opacity: 0.6; }
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover { color: var(--color-link); text-decoration: underline; }
  .hero .eyebrow { margin-top: var(--space-6); }
  .hero h1 { margin-top: var(--space-5); max-width: 22ch; }
  .hero .eyebrow + h1 { margin-top: var(--space-3); }
  .hero-lead { margin-top: var(--space-5); max-width: 62ch; font-size: var(--text-lg); color: var(--color-text-muted); }
  .hero-lead :global(* + *) { margin-top: 0.8em; }
  .hero-byline { margin-top: var(--space-4); color: var(--color-text-muted); font-size: var(--text-xs); }
  .hero-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-5); padding: 0; list-style: none; }
  .hero-chips li { padding: 0.3rem 0.8rem; border: 1px solid var(--color-border); border-radius: var(--radius-pill); font-size: var(--text-xs); color: var(--color-text-muted); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }

  .section { padding-block: var(--space-8); }
  .section + .section { padding-top: 0; }
  .hero + .section:has(.section-head > h2.visually-hidden:only-child) { padding-top: 0; }
  .section-head:has(> h2.visually-hidden:only-child) { margin: 0; }
  .section-head { max-width: 46rem; margin-bottom: var(--space-6); }
  .section-head h2 { margin-top: var(--space-2); }
  .section-intro { margin-top: var(--space-4); color: var(--color-text-muted); font-size: var(--text-lg); }
  .section-intro :global(* + *) { margin-top: 0.8em; }
  .tone-surface { background: var(--color-surface); padding-top: var(--space-8) !important; }
  .faq-wrap { max-width: 52rem; }
  .faq-note { margin-top: var(--space-5); color: var(--color-text-muted); font-size: var(--text-xs); }

  .cta {
    padding: var(--space-7) var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--brand-navy);
    color: #d6d3de;
  }
  .cta .eyebrow { color: #b9b6c3; }
  .cta h2 { margin-top: var(--space-3); color: #fff; max-width: 20ch; }
  .cta-text { max-width: 56ch; margin-block: var(--space-4) var(--space-6); font-size: var(--text-lg); }
  @media (min-width: 64em) {
    .hero { padding-block: var(--space-7) var(--space-8); }
    .section { padding-block: var(--space-9); }
    .cta { padding: var(--space-8); }
  }

  /* ---- Centered variant (dispensary pages): panel hero like the live site ---- */
  .hero--center { padding-block: var(--space-5) var(--space-6); }
  .hero--center .crumbs ol { font-size: var(--text-sm); color: var(--color-text); }
  .hero--center .crumbs li + li::before { content: '›'; margin-right: var(--space-2); opacity: 1; }
  .hero--center .crumbs a { font-weight: 500; }
  .hero--center .crumbs { margin-bottom: var(--space-4); }
  .hero--center .hero-panel {
    --hp-bg: #e4f4dd; --hp-chip: #d1decb;
    padding: 3.4rem var(--space-5) 4.5rem;
    border-radius: var(--radius-md);
    background: var(--hp-bg);
    text-align: center;
  }
  :global(:root[data-theme='dark']) .hero--center .hero-panel { --hp-bg: #162510; --hp-chip: #283423; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .hero--center .hero-panel { --hp-bg: #162510; --hp-chip: #283423; } }
  .hero--center .hero .eyebrow, .hero--center .hero-panel .eyebrow {
    display: inline-flex; align-items: center; gap: var(--space-2);
    margin: 0; padding: 0.4rem 0.9rem; border-radius: var(--radius-pill);
    background: var(--hp-chip); color: var(--color-text);
    font-size: var(--text-sm); font-weight: 500; letter-spacing: 0; text-transform: none; line-height: 1.3;
  }
  .hero--center .hero-panel h1 {
    max-width: 14em; margin: var(--space-4) auto 0;
    font-size: clamp(2.4rem, 1.5rem + 3.2vw, 4.05rem); font-weight: 500; line-height: 1; letter-spacing: -0.045em;
  }
  .hero--center .hero-lead { max-width: 56rem; margin: 2.2rem auto 0; color: var(--color-text); font-size: 1.05rem; line-height: 1.3; }
  .hero--center .hero-lead :global(p + p) { margin-top: 1.1em; }
  .hero--center .hero-lead :global(strong) { font-weight: 700; }
  .hero--center .hero-actions { justify-content: center; margin-top: 3rem; }
  .hero-marquee { margin-top: var(--space-5); }
  .hero--center .hero-actions .button { min-height: 44px; padding-inline: 1.25rem; }
  .hero--center .hero-actions .button--ghost { border: 2px solid var(--brand-violet); background: transparent; color: var(--brand-violet); }
  .hero--center .hero-actions .button--ghost:hover { background: var(--brand-violet); color: #fff; }
  :global(:root[data-theme='dark']) .hero--center .hero-actions .button--ghost { border-color: #c4b5fd; color: #c4b5fd; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .hero--center .hero-actions .button--ghost { border-color: #c4b5fd; color: #c4b5fd; } }
  @media (max-width: 40em) { .hero--center .hero-panel { padding-block: 3rem 3.5rem; } .hero--center .hero-actions { flex-direction: column; align-items: center; } }

  /* centered variant: section headings and prose centered (cards, panels, FAQ, form get their own rules) */
  .service--center .section-head { max-width: none; margin-bottom: 2.6rem; text-align: center; }
  .service--center .section-head h2 { max-width: 18em; margin: 0 auto; font-size: clamp(2rem, 1.4rem + 2vw, 3.06rem); font-weight: 500; line-height: 1.05; letter-spacing: -0.04em; }
  .service--center .section :global(.prose) { max-width: 53rem; margin-inline: auto; text-align: center; color: var(--color-text); }
  .service--center .section :global(.prose p + p) { margin-top: 1.1em; }
</style>
