---
// Case study cards: storefront screenshot, label, description, deliverables, results box and a link to the
// live site. Two side by side from 56em, stacked below. Titles are <h3> under the section <h2>.
import type { CaseStudy } from '../../lib/service-page';
interface Props { items: CaseStudy[]; reveal?: boolean }
const { items, reveal = false } = Astro.props;
---
<div class="cases">
  {items.map((c) => (
    <article class:list={['case', { reveal }]}>
      <img class="case-shot" src={c.img.src} alt={c.img.alt} width={c.img.width} height={c.img.height} loading="lazy" decoding="async" />
      <div class="case-body">
        <p class="case-label">{c.label}</p>
        <h3>{c.title}</h3>
        <div class="case-text" set:html={c.html} />
        <h4 class="case-sub">{c.deliverablesTitle ?? 'Key deliverables'}</h4>
        <ul class="case-list">{c.deliverables.map((d) => <li set:html={d} />)}</ul>
        <div class="case-results">
          <h4 class="case-sub">{c.resultsTitle}</h4>
          {c.badge && (
            <p class="case-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
              {c.badge}
            </p>
          )}
          {c.results && c.results.length > 0 && (
            <ul class:list={['case-stats', { 'case-stats--one': c.results.length === 1 }]}>
              {c.results.map((r) => <li><strong>{r.value}</strong><span>{r.label}</span></li>)}
            </ul>
          )}
          {c.note && <p class="case-note">{c.note}</p>}
        </div>
        <p class="case-actions">
          <a class="button" href={c.link.href} target="_blank" rel="noopener">{c.link.label}<span class="visually-hidden">: {c.title} (opens in a new tab)</span></a>
          {c.secondary && <a class="case-more" href={c.secondary.href}>{c.secondary.label}</a>}
        </p>
      </div>
    </article>
  ))}
</div>

<style>
  .cases { display: grid; gap: var(--space-5); text-align: left; }
  .case { display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .case-shot { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; border-bottom: 1px solid var(--color-border); }
  .case-body { display: flex; flex: 1; flex-direction: column; gap: var(--space-3); padding: var(--space-5); }
  .case-label { color: var(--color-link); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .case h3 { font-size: var(--text-h3); }
  .case-text { color: var(--color-text-muted); font-size: var(--text-sm); }
  .case-sub { margin-top: var(--space-2); color: var(--color-text-muted); font-family: var(--font-text); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .case-list { display: grid; gap: var(--space-1); padding: 0; list-style: none; font-size: var(--text-sm); }
  .case-list li { position: relative; padding-left: 1.4em; }
  .case-list li::before { content: ''; position: absolute; left: 0.15em; top: 0.55em; width: 0.45em; height: 0.45em; border-radius: 50%; background: var(--color-link); }
  .case-results { display: grid; gap: var(--space-3); margin-top: var(--space-2); padding: var(--space-4); border-radius: var(--radius-md); background: var(--color-surface-2); }
  .case-results .case-sub { margin-top: 0; }
  .case-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); padding: 0; list-style: none; }
  .case-stats--one { grid-template-columns: 1fr; }
  .case-stats li { display: grid; gap: var(--space-1); }
  .case-stats strong { color: var(--color-link); font-family: var(--font-title); font-size: clamp(1.9rem, 1.5rem + 1.2vw, 2.4rem); font-weight: 600; line-height: 1; letter-spacing: -0.02em; }
  .case-stats span { color: var(--color-text); font-size: var(--text-sm); line-height: 1.35; }
  .case-badge { display: flex; align-items: center; gap: var(--space-2); color: var(--color-heading); font-weight: 600; font-size: var(--text-sm); }
  .case-badge svg { flex: none; padding: 3px; border-radius: 50%; background: #16a34a; color: #fff; box-sizing: content-box; }
  .case-note { color: var(--color-text-muted); font-size: var(--text-xs); }
  .case-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-4); margin-top: auto; padding-top: var(--space-3); }
  .case-more { font-size: var(--text-sm); font-weight: 600; }
  @media (min-width: 56em) {
    .cases { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .case-body { padding: var(--space-6); }
  }
</style>
