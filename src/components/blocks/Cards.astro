---
// Grid of cards (features, reasons, audiences, case links). Titles are <h3> under the section <h2>.
import type { Card } from '../../lib/service-page';
interface Props { items: Card[]; columns?: 2 | 3 | 4; reveal?: boolean }
const { items, columns, reveal = false } = Astro.props;
const cols = columns ?? (items.length % 3 === 0 || items.length > 4 ? 3 : items.length === 4 ? 4 : 2);
---
<ul class:list={['cards', `cols-${cols}`]}>
  {items.map((c) => (
    <li class:list={['card', { reveal }]}>
      {c.img && <img class="card-img" src={c.img.src} alt={c.img.alt} width={c.img.width} height={c.img.height} loading="lazy" decoding="async" />}
      {(c.num || c.meta) && (
        <p class="card-top">
          {c.num && <span class="card-num">{c.num}</span>}
          {c.meta && <span class="card-meta">{c.meta}</span>}
        </p>
      )}
      <h3 set:html={c.title} />
      {c.html && <div class="card-body" set:html={c.html} />}
      {c.tags && c.tags.length > 0 && (
        <ul class="card-tags">{c.tags.map((t) => <li>{t}</li>)}</ul>
      )}
      {c.link && (
        <a class="card-link" href={c.link.href}>
          {c.link.label}<span class="visually-hidden">: {c.title.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&')}</span><span aria-hidden="true"> →</span>
        </a>
      )}
    </li>
  ))}
</ul>

<style>
  .cards { display: grid; gap: var(--space-4); padding: 0; list-style: none; }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .card-img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius-sm); }
  .card-top { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); align-items: center; font-size: var(--text-xs); }
  .card-num { font-family: var(--font-title); font-weight: 600; color: var(--color-link); letter-spacing: 0.04em; }
  .card-meta { color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
  h3 { font-size: var(--text-h4); }
  .card-body { color: var(--color-text-muted); font-size: var(--text-sm); }
  .card-body :global(* + *) { margin-top: 0.75em; }
  .card-body :global(ul) { padding-left: 1.2em; }
  .card-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: auto; padding: var(--space-2) 0 0; list-style: none; }
  .card-tags li { padding: 0.2rem 0.65rem; border-radius: var(--radius-pill); background: var(--color-surface-2); font-size: var(--text-xs); }
  .card-body :global(.best-for) { color: var(--color-text); }
  .card-link { margin-top: auto; padding-top: var(--space-2); font-weight: 600; font-size: var(--text-sm); text-decoration: none; }
  .card-link:hover { text-decoration: underline; }
  @media (min-width: 40em) {
    .cols-2, .cols-3, .cols-4 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 64em) {
    .cols-3 { grid-template-columns: repeat(3, 1fr); }
    .cols-4 { grid-template-columns: repeat(4, 1fr); }
    .cards { gap: var(--space-5); }
    .card { padding: var(--space-6); }
  }
</style>
