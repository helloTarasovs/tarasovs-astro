---
interface Props { items: { value: string; label: string }[]; reveal?: boolean }
const { items, reveal = false } = Astro.props;
---
<ul class="stats" style={`--n:${items.length}`}>
  {items.map((s) => (
    <li class:list={{ reveal }}>
      <span class="value">{s.value}</span>
      <span class="label" set:html={s.label} />
    </li>
  ))}
</ul>

<style>
  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-5); padding: 0; list-style: none; }
  li { display: flex; flex-direction: column; gap: var(--space-2); padding-top: var(--space-4); border-top: 1px solid var(--color-border); }
  .value { font-family: var(--font-title); font-size: var(--text-h1); font-weight: 500; line-height: 1; letter-spacing: var(--tracking-title); color: var(--color-heading); }
  .label { color: var(--color-text-muted); font-size: var(--text-sm); }
  @media (min-width: 64em) { .stats { grid-template-columns: repeat(var(--n), 1fr); } }
</style>
