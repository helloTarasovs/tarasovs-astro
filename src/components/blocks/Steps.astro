---
// Numbered process steps. Numbers are visual only (the <ol> carries the order).
import type { Card } from '../../lib/service-page';
interface Props { items: Card[]; reveal?: boolean }
const { items, reveal = false } = Astro.props;
---
<ol class="steps" style={`--n:${items.length}`}>
  {items.map((s, i) => (
    <li class:list={['step', { reveal }]}>
      <p class="step-top" aria-hidden="true">
        <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
        {s.meta && <span class="step-meta">{s.meta}</span>}
      </p>
      {s.meta && <p class="visually-hidden">{s.meta}</p>}
      <h3 set:html={s.title} />
      {s.html && <div class="step-body" set:html={s.html} />}
    </li>
  ))}
</ol>

<style>
  .steps { display: grid; gap: var(--space-4); padding: 0; list-style: none; }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .step-top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .step-num {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    background: var(--brand-violet);
    color: #fff;
    font-family: var(--font-title);
    font-weight: 600;
    font-size: var(--text-sm);
  }
  .step-meta { color: var(--color-text-muted); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.06em; }
  h3 { font-size: var(--text-h4); }
  h3 :global(br) { display: none; }
  .step-body { color: var(--color-text-muted); font-size: var(--text-sm); }
  .step-body :global(* + *) { margin-top: 0.75em; }
  @media (min-width: 40em) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64em) {
    .steps { grid-template-columns: repeat(min(var(--n), 4), 1fr); gap: var(--space-5); }
  }
</style>
