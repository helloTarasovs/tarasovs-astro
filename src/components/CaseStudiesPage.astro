---
// All case studies, newest first, with the category filter. Used by /case-studies/ (EN) and /ua/roboty/ (UA).
import Base from '../layouts/Base.astro';
import PortfolioGrid from './PortfolioGrid.astro';
import { breadcrumbSchema } from '../lib/schema';
import { coverPreload } from '../lib/projects';
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
  projects: CollectionEntry<'projects'>[];
  seo: { title: string; description?: string; canonical?: string; robots?: string; ogImage?: string };
  jsonld?: unknown[];
  home: { name: string; path: string };
  crumbLabel: string; // breadcrumb aria-label
  title: string;
  lead: string;
  cta: { label: string; href: string };
  url: string;
}
const { lang = 'en', projects, seo, jsonld = [], home, crumbLabel, title, lead, cta, url } = Astro.props;
const lcp = coverPreload(projects[0].data.cover);
const ld = [...jsonld, breadcrumbSchema([home, { name: title, path: url }])];
---
<Base title={seo.title} description={seo.description} canonical={seo.canonical} robots={seo.robots} ogImage={seo.ogImage} jsonld={ld}>
  {lcp && <link slot="head" rel="preload" as="image" fetchpriority="high" {...lcp} />}
  <div class="case-studies container">
    <header class="head">
      <nav class="crumbs" aria-label={crumbLabel}>
        <ol><li><a href={home.path}>{home.name}</a></li><li><span aria-current="page">{title}</span></li></ol>
      </nav>
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
      <a class="button" href={cta.href}>{cta.label}</a>
    </header>
    <PortfolioGrid projects={projects} textFilter headingLevel="h2" priorityFirst revealFrom={6} lang={lang} />
  </div>
</Base>

<style>
  .case-studies { padding-block: var(--space-6) var(--space-9); }
  .head { margin-bottom: var(--space-8); }
  .crumbs ol { display: flex; gap: var(--space-2); padding: 0; list-style: none; font-size: var(--text-xs); color: var(--color-text-muted); }
  .crumbs li + li::before { content: '/'; margin-right: var(--space-2); opacity: 0.6; }
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover { color: var(--color-link); text-decoration: underline; }
  h1 { margin-top: var(--space-5); }
  .lead { margin-block: var(--space-4) var(--space-5); color: var(--color-text-muted); font-size: var(--text-lg); }
</style>
