---
// Lead magnet: website + email -> Web3Forms (same endpoint, honeypot and submit logic as ContactForm).
// variant "inline": a section block with an <h2>.
// variant "slide": a small non-modal card in the corner (bottom sheet on phones), shown after `scroll` % of the
// page or `delay` seconds, and/or on exit intent (desktop). Shown at most once per `cooldownDays`; never again
// after this offer (`storageKey`) was submitted from any form on the site. Waits while the cookie banner is open.
import FormSubmit from './FormSubmit.astro';

interface Props {
  variant?: 'inline' | 'slide';
  id: string; // form id; field ids derive from it
  storageKey: string; // shared by the inline block and the slide-in of the same offer
  eyebrow?: string;
  title: string;
  text: string;
  submitLabel: string;
  successText: string;
  subject: string; // email subject in the notification
  leadSource: string; // goes into the notification as lead_source
  // slide only
  scroll?: number; // percent of the page scrolled
  delay?: number; // seconds on the page
  exitIntent?: boolean; // desktop: pointer leaves through the top edge
  cooldownDays?: number;
  // phones: instead of the full form, a compact bar with a button to the inline block (no full-screen overlay)
  jumpHref?: string;
  jumpLabel?: string;
  limitNote?: string; // a real limit on the offer (e.g. weekly capacity), shown as a highlighted line
  nextLabel?: string; // two-step form: website first, then email
}
const {
  variant = 'inline',
  id,
  storageKey,
  eyebrow,
  title,
  text,
  submitLabel,
  successText,
  subject,
  leadSource,
  scroll,
  delay,
  exitIntent = false,
  cooldownDays = 14,
  jumpHref,
  jumpLabel = submitLabel,
  limitNote,
  nextLabel = 'Next',
} = Astro.props;
const f = (n: string) => `${id}-${n}`;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const slide = variant === 'slide';
---
<div
  class:list={['lm', `lm--${variant}`]}
  data-lead-magnet={variant}
  data-key={storageKey}
  data-scroll={scroll}
  data-delay={delay}
  data-exit={exitIntent ? '1' : undefined}
  data-cooldown={cooldownDays}
  data-jump={jumpHref ? '1' : undefined}
  role={slide ? 'dialog' : undefined}
  aria-modal={slide ? 'false' : undefined}
  aria-labelledby={f('title')}
  hidden={slide}
>
  {slide && (
    <button class="lm-close" type="button" data-lm-close>
      <span class="visually-hidden">Close</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
  )}
  <div class="lm-copy">
    {eyebrow && <p class="lm-eyebrow">{eyebrow}</p>}
    {slide ? <p class="lm-title" id={f('title')}>{title}</p> : <h2 class="lm-title" id={f('title')}>{title}</h2>}
    <p class="lm-text">{text}</p>
    {limitNote && (
      <p class="lm-limit">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
        {limitNote}
      </p>
    )}
    {slide && jumpHref && <a class="button lm-jump" href={jumpHref} data-lm-jump>{jumpLabel}</a>}
  </div>
  <form id={id} class="lm-form" action="https://api.web3forms.com/submit" method="POST" data-contact-form data-success={successText}>
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value={subject} />
    <input type="hidden" name="from_name" value="tarasovs.me" />
    <input type="hidden" name="lead_source" value={leadSource} />
    <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <p class="visually-hidden" aria-live="polite" data-lm-step-live></p>
    <div class="lm-step" data-lm-step="1">
      <p class="lm-step-label" hidden data-lm-step-label>Step 1 of 2</p>
      <div class="lm-row">
        <div class="lm-field">
          <label for={f('website')}>Website</label>
          <input id={f('website')} name="website" type="text" inputmode="url" autocomplete="url" required maxlength="300" pattern="\S+\.\S+" title="Enter your website, for example yourbusiness.com" placeholder="yourbusiness.com" />
        </div>
        <button class="button lm-next" type="button" hidden data-lm-next>{nextLabel}</button>
      </div>
    </div>
    <div class="lm-step" data-lm-step="2">
      <p class="lm-step-label" hidden data-lm-step-label>Step 2 of 2</p>
      <p class="lm-site" hidden data-lm-site-line>Website: <strong data-lm-site></strong> <button class="lm-back" type="button" data-lm-back>Change</button></p>
      <div class="lm-row">
        <div class="lm-field">
          <label for={f('email')}>Email</label>
          <input id={f('email')} name="email" type="email" autocomplete="email" required maxlength="400" placeholder="you@yourbusiness.com" />
        </div>
        <button class="button lm-submit" type="submit" data-submit>{submitLabel}</button>
      </div>
    </div>
    <p class="lm-note">We'll only use your email for this request. <a href="/privacy-cookie-policy-tarasovs-digital-agency/">Privacy policy</a></p>
    <p class="status" role="status" aria-live="polite" data-status></p>
  </form>
</div>
<FormSubmit />

<style>
  .lm { color: var(--color-text); }
  .lm-eyebrow { color: var(--color-link); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .lm-title { margin-top: var(--space-2); color: var(--color-heading); font-family: var(--font-title); font-weight: 600; line-height: 1.15; letter-spacing: -0.02em; }
  .lm-text { margin-top: var(--space-3); color: var(--color-text-muted); }
  .lm-limit {
    display: inline-flex; align-items: center; gap: var(--space-2);
    margin-top: var(--space-3); padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill); background: color-mix(in srgb, var(--brand-violet) 12%, transparent);
    color: var(--color-heading); font-size: var(--text-sm); font-weight: 600; line-height: 1.3;
  }
  .lm-limit svg { flex: none; color: var(--color-link); }
  .lm--slide .lm-limit { font-size: var(--text-xs); }
  .lm-form { display: grid; gap: var(--space-3); margin-top: var(--space-5); }
  .lm-step { display: grid; gap: var(--space-2); }
  .lm-step[hidden], .lm-step-label[hidden], .lm-site[hidden], .lm-next[hidden] { display: none; }
  .lm-step-label { color: var(--color-text-muted); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .lm-row { display: grid; gap: var(--space-3); align-items: end; }
  .lm-next, .lm-submit { width: 100%; min-height: 48px; }
  .lm-site { font-size: var(--text-sm); color: var(--color-text-muted); overflow-wrap: anywhere; }
  .lm-site strong { color: var(--color-heading); }
  .lm-back { min-height: 32px; padding: 0 var(--space-1); border: 0; background: none; color: var(--color-link); font: inherit; font-weight: 600; text-decoration: underline; cursor: pointer; }
  .lm-field { display: grid; gap: var(--space-1); }
  .lm-field label { font-size: var(--text-sm); font-weight: 500; }
  .lm-field input {
    width: 100%; min-height: 48px; padding: 0.7rem 1rem;
    border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    background: var(--color-bg); color: var(--color-text); font-size: 1rem;
  }
  .lm-field input::placeholder { color: var(--color-text-muted); opacity: 0.8; }
  .lm-field input:focus-visible { border-color: var(--color-focus); outline-offset: 0; }
  .lm-submit[disabled] { opacity: 0.7; cursor: progress; }
  .lm-note { color: var(--color-text-muted); font-size: var(--text-xs); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .status:empty { display: none; }
  .status { padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); font-size: var(--text-sm); }
  .status.is-success { background: color-mix(in srgb, #16a34a 14%, transparent); }
  .status.is-error { background: color-mix(in srgb, #dc2626 14%, transparent); }

  /* inline: violet panel, copy and form side by side on desktop */
  .lm--inline {
    display: grid; gap: var(--space-5);
    padding: var(--space-6) var(--space-5);
    border: 1px solid color-mix(in srgb, var(--brand-violet) 25%, transparent);
    border-radius: var(--radius-lg);
    background: var(--color-lm-panel);
    text-align: left;
    --color-link: var(--color-lm-link);
  }
  .lm--inline .lm-title { font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.1rem); }
  .lm--inline .lm-form { margin-top: 0; }
  /* inline block: field and button on one line from 40em */
  @media (min-width: 40em) { .lm--inline .lm-row { grid-template-columns: 1fr auto; } .lm--inline .lm-next, .lm--inline .lm-submit { width: auto; padding-inline: 1.5rem; } }
  @media (min-width: 64em) {
    .lm--inline { grid-template-columns: 1fr 1.15fr; align-items: center; gap: var(--space-7); padding: var(--space-7); }
  }

  /* slide: small card in the corner, bottom sheet on phones */
  .lm--slide {
    position: fixed; z-index: 90; right: var(--space-4); bottom: var(--space-4);
    width: min(380px, calc(100vw - 2 * var(--space-4)));
    max-height: calc(100dvh - 96px); overflow-y: auto;
    padding: var(--space-5);
    border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    background: var(--color-surface); box-shadow: var(--shadow-md, 0 12px 32px rgb(0 0 0 / 0.18));
    transform: translateY(0); opacity: 1;
    transition: transform 260ms var(--ease), opacity 260ms var(--ease);
  }
  .lm--slide.is-entering { transform: translateY(16px); opacity: 0; }
  .lm--slide[hidden] { display: none; }
  .lm--slide .lm-title { padding-right: var(--space-6); font-size: var(--text-h4); }
  .lm--slide .lm-text { font-size: var(--text-sm); }
  .lm-close {
    position: absolute; top: var(--space-2); right: var(--space-2);
    display: grid; place-items: center; width: 44px; height: 44px;
    border: 0; border-radius: var(--radius-pill); background: transparent; color: var(--color-heading); cursor: pointer;
  }
  .lm-close:hover { background: var(--color-surface-2); }
  .lm-jump { display: none; }
  @media (max-width: 40em) {
    .lm--slide { right: 0; left: 0; bottom: 0; width: auto; padding: var(--space-4); border-radius: var(--radius-lg) var(--radius-lg) 0 0; border-bottom: 0; }
    /* compact bar on phones: title + button to the inline form, never a full-screen overlay */
    .lm--slide .lm-text, .lm--slide .lm-form { display: none; }
    .lm--slide .lm-jump { display: flex; width: 100%; margin-top: var(--space-3); }
  }
  @media (prefers-reduced-motion: reduce) { .lm--slide { transition: none; } }
</style>

<script>
  const DAY = 86400000;
  const read = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const write = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };

  // Two-step form: website -> Next -> email -> submit. Without JS both steps simply show together.
  document.querySelectorAll<HTMLElement>('[data-lead-magnet]').forEach((box) => {
    const form = box.querySelector('form')!;
    const [one, two] = [...form.querySelectorAll<HTMLElement>('[data-lm-step]')];
    const site = form.querySelector<HTMLInputElement>('input[name="website"]')!;
    const email = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-lm-next]')!;
    const live = form.querySelector<HTMLElement>('[data-lm-step-live]')!;
    form.querySelectorAll<HTMLElement>('[data-lm-step-label], [data-lm-site-line]').forEach((el) => (el.hidden = false));
    next.hidden = false;
    const go = (step: 1 | 2, focus = true) => {
      one.hidden = step !== 1;
      two.hidden = step !== 2;
      form.querySelector<HTMLElement>('[data-lm-site]')!.textContent = site.value.trim();
      live.textContent = step === 2 ? 'Step 2 of 2: your email' : '';
      if (focus) (step === 2 ? email : site).focus();
    };
    const toEmail = () => { if (site.reportValidity()) go(2); };
    next.addEventListener('click', toEmail);
    site.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); toEmail(); } });
    form.querySelector('[data-lm-back]')!.addEventListener('click', () => go(1));
    box.addEventListener('form:success', () => go(1, false));
    go(1, false);
  });

  // Any successful submit of an offer (inline or slide) means: never offer it again.
  document.querySelectorAll<HTMLElement>('[data-lead-magnet]').forEach((box) => {
    box.addEventListener('form:success', () => write(`${box.dataset.key}:done`, '1'));
  });

  document.querySelectorAll<HTMLElement>('[data-lead-magnet="slide"]').forEach((box) => {
    const key = box.dataset.key!;
    if (read(`${key}:done`)) return;
    const dismissed = Number(read(`${key}:dismissed`) || 0);
    const cooldown = Number(box.dataset.cooldown || 14) * DAY;
    if (dismissed && Date.now() - dismissed < cooldown) return;

    const consent = document.getElementById('analytics-consent');
    const inline = document.querySelector<HTMLElement>(`[data-lead-magnet="inline"][data-key="${key}"]`);
    let inlineVisible = false;
    if (inline && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => { inlineVisible = e.isIntersecting; }).observe(inline);
    }
    let shown = false;
    const cleanup: (() => void)[] = [];

    const show = () => {
      if (shown || read(`${key}:done`) || !allowed()) return;
      // the same offer is already on screen, or the cookie banner is open: try again on the next trigger
      if (inlineVisible) return;
      if (consent && !consent.hidden) return;
      shown = true;
      cleanup.forEach((fn) => fn());
      box.hidden = false;
      box.classList.add('is-entering');
      requestAnimationFrame(() => requestAnimationFrame(() => box.classList.remove('is-entering')));
    };
    const close = () => {
      box.hidden = true;
      write(`${key}:dismissed`, String(Date.now()));
    };

    box.querySelector('[data-lm-close]')?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !box.hidden) close(); });
    box.addEventListener('form:success', () => setTimeout(() => { box.hidden = true; }, 4000));

    // phones get the compact bar only when it can link to an inline form; otherwise nothing at all
    const phone = matchMedia('(max-width: 40em)');
    box.querySelector('[data-lm-jump]')?.addEventListener('click', () => { box.hidden = true; write(`${key}:dismissed`, String(Date.now())); });
    const allowed = () => !phone.matches || !!box.dataset.jump;

    const scrollPct = Number(box.dataset.scroll || 0);
    if (scrollPct) {
      const onScroll = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        if (max > 0 && (scrollY / max) * 100 >= scrollPct) show();
      };
      addEventListener('scroll', onScroll, { passive: true });
      cleanup.push(() => removeEventListener('scroll', onScroll));
    }
    const delay = Number(box.dataset.delay || 0);
    if (delay) {
      const t = setInterval(show, delay * 1000); // retries if the first moment was blocked
      cleanup.push(() => clearInterval(t));
    }
    if (box.dataset.exit && matchMedia('(pointer: fine)').matches) {
      const onLeave = (e: MouseEvent) => { if (!e.relatedTarget && e.clientY <= 0) show(); };
      document.addEventListener('mouseout', onLeave);
      cleanup.push(() => document.removeEventListener('mouseout', onLeave));
    }
  });
</script>
