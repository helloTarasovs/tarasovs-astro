---
// Project inquiry form for /services/ai-video-production/. Posts to Web3Forms (same mechanism as ContactForm);
// the shared FormSubmit script handles fetch, sending state, success and error. Extra fields travel with the message:
// page, selected service and agency flag.
import { FORM_SERVICES } from '../data/ai-video';
import { UK } from '../data/ai-video-uk';
import { PACKAGES, PACKAGES_EN, PACKAGES_UK, CUSTOM_PACKAGE, formatPrice } from '../data/ai-video-packages';

interface Props { lang?: 'en' | 'uk' }
const lang = Astro.props.lang ?? 'en';
const uk = lang === 'uk';
const services = uk ? UK.formServices : FORM_SERVICES;
const pk = (uk ? PACKAGES_UK : PACKAGES_EN).ui;
const announce = pk.announce;
const announceCustom = uk ? 'Вибрано індивідуальний проєкт. Заповніть форму запиту нижче.' : 'Selected: custom project. Please fill in the project inquiry form below.';
const t = uk ? {
  name: "Ім'я", email: 'Емейл', company: 'Компанія або сайт', service: 'Послуга', agency: 'Проєкт для агенції', brief: 'Бриф проєкту',
  placeholder: 'Що ви створюєте, для кого і де використовуватиметься відео? Можна додати посилання на референси.',
  date: 'Бажана дата запуску', budget: 'Орієнтовний бюджет', req: "(обов'язково)", opt: "(необов'язково)", submit: 'Надіслати запит',
  consent: ['Надсилаючи форму, я погоджуюся з', 'умовами використання (англ.)', 'і', 'політикою конфіденційності'], privacy: '/ua/polityka-konfidentsiinosti/',
  sending: 'Надсилаємо…',
  success: 'Дякуємо! Запит надіслано. Ми розглянемо бриф і повернемося з наступним кроком.',
  error: 'Не вдалося надіслати запит. Введений текст збережено, можна спробувати ще раз або написати на hello@tarasovs.me.',
} : {
  name: 'Name', email: 'Email', company: 'Company or website', service: 'Service', agency: 'Agency project', brief: 'Project brief',
  placeholder: 'What are you creating, who is it for and where will the video be used? You can include links to references.',
  date: 'Target launch date', budget: 'Approximate budget', req: '(required)', opt: '(optional)', submit: 'Send project inquiry',
  consent: ['By submitting this form, I agree to the', 'terms & conditions', 'and', 'privacy policy'], privacy: '/privacy-cookie-policy-tarasovs-digital-agency/',
  sending: 'Sending…',
  success: 'Thank you! Your project inquiry has been sent. We will review the brief and get back to you with the next step.',
  error: 'Sorry, the inquiry could not be sent. Your text is still here, so you can try again, or email hello@tarasovs.me.',
};
import FormSubmit from './FormSubmit.astro';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const pageUrl = uk ? 'https://tarasovs.me/ua/ai-video-produktsiia/' : 'https://tarasovs.me/services/ai-video-production/';
---
<form id="video-inquiry" class="vform" action="https://api.web3forms.com/submit" method="POST" data-contact-form data-video-form
  data-success={t.success} data-sending={t.sending}
  data-error={t.error}>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="New AI video project inquiry" />
  <input type="hidden" name="from_name" value="tarasovs.me" />
  <input type="hidden" name="inquiry_page" value={pageUrl} />
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="row">
    <div class="field">
      <label for="vf-name">{t.name} <span class="req">{t.req}</span></label>
      <input id="vf-name" name="name" type="text" autocomplete="name" required maxlength="200" />
    </div>
    <div class="field">
      <label for="vf-email">{t.email} <span class="req">{t.req}</span></label>
      <input id="vf-email" name="email" type="email" autocomplete="email" required maxlength="200" />
    </div>
  </div>
  <div class="row">
    <div class="field">
      <label for="vf-company">{t.company} <span class="req">{t.opt}</span></label>
      <input id="vf-company" name="company_or_website" type="text" autocomplete="organization" maxlength="300" />
    </div>
    <div class="field">
      <label for="vf-service">{t.service} <span class="req">{t.opt}</span></label>
      <select id="vf-service" name="service">
        {services.map((s) => <option value={s.label} data-id={s.value}>{s.label}</option>)}
      </select>
    </div>
  </div>
  <div class="field">
    <label for="vf-package">{pk.formLabel} <span class="req">{t.opt}</span></label>
    <select id="vf-package" name="package">
      <option value="" data-name="">{pk.notSure}</option>
      {PACKAGES.map((p) => <option value={p.id} data-service={p.serviceId} data-name={p.name} data-price={p.startingPrice} data-currency={p.currency}>{p.name}, {pk.from.toLowerCase()} {formatPrice(p)}</option>)}
      <option value={CUSTOM_PACKAGE.id} data-name={CUSTOM_PACKAGE.name}>{pk.customLabel}</option>
    </select>
    <p class="visually-hidden" role="status" aria-live="polite" id="vf-package-live" data-text={announce} data-custom={announceCustom}></p>
  </div>
  <label class="check"><input type="checkbox" id="vf-agency" name="agency_project" value="Yes" /><span>{t.agency}</span></label>
  <div class="field">
    <label for="vf-brief">{t.brief} <span class="req">{t.req}</span></label>
    <textarea id="vf-brief" name="message" rows="6" required maxlength="3000" placeholder={t.placeholder}></textarea>
  </div>
  <div class="row">
    <div class="field">
      <label for="vf-date">{t.date} <span class="req">{t.opt}</span></label>
      <input id="vf-date" name="target_launch_date" type="text" maxlength="100" />
    </div>
    <div class="field">
      <label for="vf-budget">{t.budget} <span class="req">{t.opt}</span></label>
      <input id="vf-budget" name="approximate_budget" type="text" maxlength="100" />
    </div>
  </div>

  <p class="consent">
    {t.consent[0]} <a href={uk ? '/terms-of-service-tarasovs-digital-agency/' : '/terms-of-service-tarasovs-digital-agency/'}>{t.consent[1]}</a> {t.consent[2]} <a href={t.privacy}>{t.consent[3]}</a>.
  </p>
  <button class="button" type="submit" data-submit>{t.submit}</button>
  <p class="status" role="status" aria-live="polite" data-status></p>
</form>

<style>
  .vform { display: grid; gap: var(--space-4); }
  .row { display: grid; gap: var(--space-4); }
  @media (min-width: 40em) { .row { grid-template-columns: 1fr 1fr; } }
  .field { display: grid; gap: var(--space-2); }
  label { font-weight: 500; font-size: var(--text-sm); }
  .req { color: var(--color-text-muted); font-weight: 400; }
  input:not([type='hidden']):not([type='checkbox']), textarea, select {
    width: 100%; min-height: 48px; padding: 0.75rem 1rem;
    border: 1px solid var(--color-text-muted); border-radius: var(--radius-sm);
    background: var(--color-bg); color: var(--color-text); font: inherit; font-size: 1rem;
  }
  textarea { resize: vertical; min-height: 150px; }
  textarea::placeholder { color: var(--color-text-muted); opacity: 1; }
  input:focus-visible, textarea:focus-visible, select:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .check { display: inline-flex; align-items: center; gap: var(--space-3); min-height: 44px; cursor: pointer; }
  .check input { width: 1.25rem; height: 1.25rem; margin: 0; accent-color: var(--brand-violet); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .consent { color: var(--color-text-muted); font-size: var(--text-xs); }
  .button { justify-self: start; min-width: 200px; }
  .button[disabled] { opacity: 0.7; cursor: progress; }
  .status:empty { display: none; }
  .status { padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); font-size: var(--text-sm); }
  .status.is-success { background: color-mix(in srgb, #16a34a 14%, transparent); }
  .status.is-error { background: color-mix(in srgb, #dc2626 14%, transparent); }
</style>

<FormSubmit />
